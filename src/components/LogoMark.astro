---
// Isotipo "Ojo Umbral": cinta fluida (memoria continua) + ojo de conciencia.
// Basado en la variante 03 de Stitch (Lujo Etéreo & Bio-Geometría Fluida).
interface Props { size?: number; class?: string; }
const { size = 40, class: className } = Astro.props;
---
<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 60 60"
	fill="none"
	xmlns="http://www.w3.org/2000/svg"
	role="img"
	aria-label="Regresión a Vidas Pasadas"
>
	<circle cx="30" cy="30" r="28" stroke="#E6C875" stroke-opacity="0.3" stroke-width="0.8" />
	<path
		d="M12,31 C10,18 20,10 32,10 C44,10 51,20 49,31 C47,43 37,50 27,49 C17,48 11,38 13,27 C15,18 25,16 31,18"
		stroke="#E6C875"
		stroke-width="2"
		stroke-linecap="round"
	/>
	<path d="M20,30 C23,24 37,24 40,30 C37,36 23,36 20,30 Z" stroke="#FAF7F2" stroke-width="1" />
	<circle cx="30" cy="30" r="2" fill="#FAF7F2" />
</svg>

---
// Pagefind search modal — included once in each layout
---

<dialog id="search-dialog" aria-label="Buscar en el sitio" data-pagefind-ignore>
	<div class="search-inner">
		<div class="search-header">
			<span class="search-title">Buscar</span>
			<button class="search-close" id="search-close" aria-label="Cerrar búsqueda">✕</button>
		</div>
		<div id="search-box"></div>
	</div>
</dialog>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />

<script>
	const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
	const closeBtn = document.getElementById('search-close');
	let initialized = false;

	async function initSearch() {
		if (initialized) return;
		initialized = true;
		// Load pagefind via script tag to avoid Vite static analysis (pagefind is generated at postbuild)
		await new Promise<void>((resolve, reject) => {
			const s = document.createElement('script');
			s.src = '/pagefind/pagefind-ui.js';
			s.onload = () => resolve();
			s.onerror = reject;
			document.head.appendChild(s);
		});
		// @ts-ignore
		new window.PagefindUI({
			element: '#search-box',
			showSubResults: false,
			translations: {
				placeholder: 'Buscar artículos...',
				zero_results: 'Sin resultados para "[SEARCH_TERM]"',
			},
		});
	}

	dialog?.addEventListener('click', (e) => {
		if (e.target === dialog) dialog.close();
	});

	dialog?.addEventListener('close', () => {
		// Reset search when closed
		const input = dialog.querySelector('input');
		if (input) input.value = '';
		dialog.querySelector<HTMLButtonElement>('.pagefind-ui__search-clear')?.click();
	});

	closeBtn?.addEventListener('click', () => dialog?.close());

	// Init on first open. No dependemos del evento "toggle" de <dialog>: muchos
	// navegadores móviles no lo disparan y el buscador se quedaba vacío.
	function whenOpen() {
		if (dialog?.open) {
			initSearch().then(() => {
				const input = dialog.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
				input?.focus();
			});
		}
	}
	if (dialog) {
		new MutationObserver(whenOpen).observe(dialog, { attributes: true, attributeFilter: ['open'] });
	}
	document.getElementById('search-trigger')?.addEventListener('click', () => setTimeout(whenOpen, 0));
</script>

<style>
	dialog {
		position: fixed;
		inset: 0;
		margin: auto;
		width: 90%;
		max-width: 640px;
		max-height: 80vh;
		border: 1px solid rgba(230, 200, 117, 0.25);
		border-radius: 18px;
		background: #0E1514;
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
		padding: 0;
		overflow: hidden;
	}

	dialog::backdrop {
		background: rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(2px);
	}

	@media (max-width: 720px) {
		dialog {
			width: calc(100% - 1.5rem);
			margin: 0.75rem auto auto;
			max-height: calc(100dvh - 1.5rem);
		}
		.search-inner { max-height: calc(100dvh - 1.5rem); }
	}

	.search-inner {
		display: flex;
		flex-direction: column;
		height: 100%;
		max-height: 80vh;
	}

	.search-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1em 1.25em 0.75em;
		border-bottom: 1px solid rgba(230, 200, 117, 0.12);
	}

	.search-title {
		font-family: 'Syne', serif;
		font-size: 0.75em;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: #BA9C4B;
	}

	.search-close {
		background: none;
		border: none;
		cursor: pointer;
		color: #BA9C4B;
		font-size: 1em;
		padding: 0.25em 0.5em;
		border-radius: 12px;
		transition: color 0.2s, background 0.2s;
		line-height: 1;
	}

	.search-close:hover {
		color: #FAF7F2;
		background: rgba(230, 200, 117, 0.1);
	}

	#search-box {
		padding: 1em 1.25em;
		overflow-y: auto;
		flex: 1;
	}

	/* Pagefind UI overrides to match site palette */
	#search-box {
		--pagefind-ui-scale: 1;
		--pagefind-ui-primary: #E6C875;
		--pagefind-ui-text: #FAF7F2;
		--pagefind-ui-background: #151E1D;
		--pagefind-ui-border: rgba(230, 200, 117, 0.35);
		--pagefind-ui-tag: #1B2625;
		--pagefind-ui-border-width: 1px;
		--pagefind-ui-border-radius: 14px;
		--pagefind-ui-font: 'Plus Jakarta Sans', sans-serif;
	}

	#search-box :global(.pagefind-ui__search-input) {
		font-family: 'Plus Jakarta Sans', sans-serif;
		font-size: 1em;
		font-weight: 500;
		border: 1px solid rgba(230, 200, 117, 0.35);
		border-radius: 14px;
		padding: 0 5em 0 3.2em;
		height: 3.2em;
		font-size: max(16px, 1em);
		background-color: #151E1D;
		color: #FAF7F2;
		width: 100%;
		outline: none;
	}

	#search-box :global(.pagefind-ui__search-input::placeholder) {
		color: rgba(250, 247, 242, 0.6);
		opacity: 1;
	}

	#search-box :global(.pagefind-ui__search-input:focus) {
		border-color: #E6C875;
		box-shadow: 0 0 0 3px rgba(230, 200, 117, 0.15);
	}

	#search-box :global(.pagefind-ui__message) {
		color: #BA9C4B;
		font-size: 0.8em;
	}

	#search-box :global(.pagefind-ui__result) {
		border-top: 1px solid rgba(230, 200, 117, 0.1);
		padding: 0.85em 0;
	}

	#search-box :global(.pagefind-ui__result-title) {
		font-family: 'Syne', serif;
		font-size: 0.9em;
		color: #FAF7F2;
	}

	#search-box :global(.pagefind-ui__result-title a) {
		color: #E6C875;
		text-decoration: none;
	}

	#search-box :global(.pagefind-ui__result-title a:hover) {
		text-decoration: underline;
	}

	#search-box :global(.pagefind-ui__result-excerpt) {
		font-size: 0.85em;
		color: #C6C0B1;
		line-height: 1.55;
		margin-top: 0.25em;
	}

	#search-box :global(mark) {
		background: rgba(230, 200, 117, 0.2);
		color: #FAF7F2;
		border-radius: 8px;
	}

	#search-box :global(.pagefind-ui__search-clear) {
		background: rgba(230, 200, 117, 0.12);
		color: #E6C875;
		border-radius: 999px;
		font-size: 0.75em;
	}
	#search-box :global(.pagefind-ui__search-clear:hover) {
		background: rgba(230, 200, 117, 0.25);
	}
</style>

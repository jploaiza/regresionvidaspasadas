---
// Botones para compartir una página (o una ficha dentro de ella con #ancla).
// El texto y el enlace salen con la marca: el título y el dominio del portal.
interface Props {
	path: string;
	title: string;
	compact?: boolean;
	label?: string;
}

const { path, title, compact = false, label = 'Compartir' } = Astro.props;
const url = new URL(path, Astro.site ?? 'https://www.regresionvidaspasadas.com').href;
const u = encodeURIComponent(url);
const t = encodeURIComponent(`${title} — Regresión a Vidas Pasadas`);

const IC = {
	whatsapp: 'M12.04 2a9.9 9.9 0 0 0-8.5 14.95L2 22l5.2-1.5A9.9 9.9 0 1 0 12.04 2Zm5.8 14.1c-.25.7-1.45 1.3-2 1.35-.5.05-1.15.07-1.85-.12-.43-.13-.97-.31-1.67-.61-2.94-1.27-4.86-4.23-5-4.43-.15-.2-1.2-1.6-1.2-3.05 0-1.45.76-2.16 1.03-2.46.27-.3.6-.37.8-.37h.58c.19 0 .43-.07.67.5.25.6.84 2.05.91 2.2.07.15.12.32.02.52-.1.2-.15.32-.3.5-.15.17-.31.38-.44.51-.15.15-.3.31-.13.6.17.3.77 1.27 1.65 2.05 1.13 1 2.09 1.32 2.39 1.47.3.15.47.12.65-.07.17-.2.75-.87.95-1.17.2-.3.4-.25.67-.15.27.1 1.72.81 2.02.96.3.15.5.22.57.35.07.12.07.72-.18 1.4Z',
	facebook: 'M13.5 22v-8.2h2.8l.45-3.3H13.5V8.43c0-.95.27-1.6 1.63-1.6h1.7V3.88A22.7 22.7 0 0 0 14.35 3.75c-2.5 0-4.2 1.5-4.2 4.3v2.45H7.3v3.3h2.85V22h3.35Z',
	x: 'M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.78L17.75 3Zm-1.08 16.17h1.7L7.4 4.74H5.58l11.09 14.43Z',
	telegram: 'M21.5 4.1 18.4 19c-.23 1.05-.85 1.3-1.72.81l-4.75-3.5-2.29 2.2c-.25.25-.47.47-.95.47l.34-4.84 8.8-7.95c.38-.34-.08-.53-.6-.19L6.35 12.85l-4.7-1.47c-1.02-.32-1.04-1.02.21-1.51L20.2 2.8c.85-.31 1.6.2 1.3 1.3Z',
	linkedin: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11.5H3V9.75Zm6.5 0h3.83v1.57h.05c.53-1 1.84-2.07 3.78-2.07 4.04 0 4.79 2.66 4.79 6.12v5.88h-4v-5.2c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75v5.29h-4V9.75Z',
	correo: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1.4 2 7.6 5.7L19.6 7H4.4Zm-.4 1.9V17h16V8.9l-8 6-8-6Z',
	copiar: 'M9 3h9a2 2 0 0 1 2 2v11h-2V5H9V3Zm-3 4h9a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Zm0 2v10h9V9H6Z',
	mas: 'M18 16.1c-.76 0-1.44.3-1.96.77L8.9 12.7c.05-.23.1-.46.1-.7s-.05-.47-.1-.7l7.05-4.11A2.99 2.99 0 1 0 15 5c0 .24.04.47.09.7L8.04 9.81a3 3 0 1 0 0 4.38l7.12 4.16c-.05.21-.08.43-.08.65A2.92 2.92 0 1 0 18 16.1Z',
};
const redes = [
	{ k: 'whatsapp', nombre: 'WhatsApp', href: `https://api.whatsapp.com/send?text=${t}%20${u}` },
	{ k: 'facebook', nombre: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}` },
	{ k: 'x', nombre: 'X', href: `https://twitter.com/intent/tweet?url=${u}&text=${t}` },
	{ k: 'telegram', nombre: 'Telegram', href: `https://t.me/share/url?url=${u}&text=${t}` },
	{ k: 'linkedin', nombre: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
	{ k: 'correo', nombre: 'Correo', href: `mailto:?subject=${t}&body=${u}` },
];
const visibles = compact ? redes.slice(0, 3) : redes;
---

<div class:list={['share', { 'share--compact': compact }]} data-pagefind-ignore data-share-url={url} data-share-title={title}>
	{!compact && <span class="share-label">{label}</span>}
	<div class="share-chips" role="group" aria-label={label}>
		{visibles.map((r) => (
			<a class="share-ico" href={r.href} target="_blank" rel="noopener noreferrer" title={r.nombre} aria-label={`${label} en ${r.nombre}: ${title}`}>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d={IC[r.k]} /></svg>
			</a>
		))}
		<button type="button" class="share-ico share-copy" data-share-copy title="Copiar enlace" aria-label={`Copiar el enlace de ${title}`}>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d={IC.copiar} /></svg>
		</button>
		<button type="button" class="share-ico share-native" data-share-native hidden title="Más opciones" aria-label={`Compartir ${title}`}>
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d={IC.mas} /></svg>
		</button>
	</div>
</div>
<script>
	function setup() {
		document.querySelectorAll<HTMLElement>('.share').forEach((box) => {
			if (box.dataset.ready) return;
			box.dataset.ready = '1';
			const url = box.dataset.shareUrl ?? location.href;
			const title = box.dataset.shareTitle ?? document.title;
			const copy = box.querySelector<HTMLButtonElement>('[data-share-copy]');
			const nativo = box.querySelector<HTMLButtonElement>('[data-share-native]');

			copy?.addEventListener('click', async () => {
				
				try {
					await navigator.clipboard.writeText(url);
				} catch {
					const ta = document.createElement('textarea');
					ta.value = url;
					ta.style.position = 'fixed';
					ta.style.opacity = '0';
					document.body.appendChild(ta);
					ta.select();
					try { document.execCommand('copy'); } catch {}
					ta.remove();
				}
				copy.textContent = '¡Copiado!';
				setTimeout(() => { copy.textContent = original; }, 1800);
			});

			if (nativo && typeof navigator.share === 'function') {
				nativo.hidden = false;
				nativo.addEventListener('click', () => {
					navigator.share({ title: `${title} — Regresión a Vidas Pasadas`, url }).catch(() => {});
				});
			}
		});
	}
	setup();
</script>

<style>
	.share {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5em 0.8em;
		margin: 1.6em 0 0;
		padding-top: 1.1em;
		border-top: 1px solid rgba(230, 200, 117, 0.15);
	}
	.share-label {
		font-family: 'Syne', sans-serif;
		font-size: 0.62em;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #BA9C4B;
	}
	.share-chips { display: flex; flex-wrap: wrap; gap: 0.4em; }
	.share-ico {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 30px;
		height: 30px;
		padding: 0;
		border-radius: 50%;
		border: 1px solid rgba(230, 200, 117, 0.3);
		background: rgba(230, 200, 117, 0.04);
		color: #E6C875;
		cursor: pointer;
		transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s;
	}
	.share-ico svg { width: 14px; height: 14px; fill: currentColor; display: block; }
	.share-ico:hover,
	.share-ico:focus-visible { background: #E6C875; border-color: #E6C875; color: #090E0D; transform: translateY(-1px); }
	.share-ico.is-ok { background: #E6C875; color: #090E0D; border-color: #E6C875; }
	.share-ico[hidden] { display: none; }

	/* Compacto: fila diminuta bajo el póster o la portada, sin línea ni etiqueta */
	.share--compact { margin: 0.55em 0 0; padding: 0; border: 0; }
	.share--compact .share-chips { flex-wrap: nowrap; gap: 0.25em; justify-content: space-between; }
	.share--compact .share-ico { width: 22px; height: 22px; border-color: rgba(230, 200, 117, 0.22); }
	.share--compact .share-ico svg { width: 11px; height: 11px; }
	.share--compact .share-native { display: none; }
	@media (max-width: 600px) {
		.share--compact .share-ico { width: 19px; height: 19px; }
		.share--compact .share-ico svg { width: 10px; height: 10px; }
	}
</style>

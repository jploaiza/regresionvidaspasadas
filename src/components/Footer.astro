---
import LogoMark from './LogoMark.astro';
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-logo"><LogoMark size={44} /><span>REGRESIÓN <em>a vidas pasadas</em></span></div>

		<nav class="footer-links">
			<a href="/blog">Artículos</a>
			<a href="/expositores">Expositores</a>
			<a href="/srt">SRT</a>
			<a href="/hipnosis">Hipnosis</a>
			<a href="/libros">Libros</a>
			<a href="https://www.juanpabloloaiza.com" target="_blank" rel="noopener" class="footer-link-highlight">Juan Pablo Loaiza · TRVP</a>
		</nav>

		<p class="footer-desc">
			Portal de conocimiento independiente para la exploración de la consciencia transpersonal.
			Investigación en regresión a vidas pasadas, hipnosis clínica y liberación espiritual.
		</p>

		<p class="footer-copy">© {today.getFullYear()} Regresión a Vidas Pasadas. Portal de conocimiento espiritual independiente.</p>
	</div>
</footer>

<style>
	footer {
		background: #090E0D;
		border-top: 1px solid rgba(230, 200, 117, 0.3);
		transition: opacity 0.3s;
	}

	footer:hover { opacity: 1; }

	.footer-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5em;
		padding: 3.5em 2em;
		text-align: center;
		max-width: 1200px;
		margin: 0 auto;
	}

	.footer-logo {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.7em;
		font-family: 'Cormorant Garamond', serif;
		font-size: 1.15em;
		font-weight: 400;
		color: #FAF7F2;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.footer-logo em {
		font-family: 'Newsreader', serif;
		font-size: 0.85em;
		color: #E6C875;
		text-transform: none;
		letter-spacing: 0.02em;
	}

	.footer-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5em 2em;
	}

	.footer-links a {
		font-family: 'EB Garamond', serif;
		font-size: 0.9em;
		color: #C6C0B1;
		text-decoration: none;
		transition: color 0.2s;
	}

	.footer-links a:hover { color: #FAF7F2; text-decoration: none; }

	.footer-link-highlight {
		color: #E6C875 !important;
		text-decoration: underline !important;
	}
	.footer-link-highlight:hover { color: #E6C875 !important; }

	.footer-desc {
		font-family: 'EB Garamond', serif;
		font-size: 0.78em;
		color: #C6C0B1;
		line-height: 1.65;
		max-width: 540px;
		margin: 0;
		opacity: 0.7;
	}

	.footer-copy {
		font-family: 'EB Garamond', serif;
		font-size: 0.75em;
		color: #FAF7F2;
		opacity: 0.6;
		margin: 0;
	}
</style>

---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	seoTitle?: string;
	description: string;
	image?: ImageMetadata;
	ogImage?: string;
	ogType?: 'website' | 'article';
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, seoTitle, description, image, ogImage, ogType = 'website' } = Astro.props;
// Imagen al compartir: la del artículo, una ruta propia (/og/...) o la imagen de marca por defecto.
const socialImage = ogImage
	? new URL(ogImage, Astro.site).href
	: image
		? new URL(image.src, Astro.url).href
		: new URL('/og/og-default.jpg', Astro.site).href;
const headTitle = seoTitle ?? title;

const SITE_URL = 'https://www.regresionvidaspasadas.com';

const siteSchemas = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: 'Regresión a Vidas Pasadas',
    url: SITE_URL,
    inLanguage: 'es',
    publisher: { '@id': `${SITE_URL}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: 'Regresión a Vidas Pasadas',
    url: SITE_URL,
    description: 'Portal editorial especializado en regresión a vidas pasadas, hipnosis clínica y liberación espiritual.',
    founder: { '@id': 'https://www.juanpabloloaiza.com/#person' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': 'https://www.juanpabloloaiza.com/#person',
    name: 'Juan Pablo Loaiza',
    url: 'https://www.juanpabloloaiza.com',
    sameAs: [
      'https://www.youtube.com/@jploaizao',
      'https://www.instagram.com/jploaizao',
      'https://www.tiktok.com/@jploaizao',
    ],
    jobTitle: 'Terapeuta de Regresión a Vidas Pasadas',
    knowsAbout: [
      'Regresión a Vidas Pasadas',
      'Hipnosis Clínica',
      'Liberación Espiritual',
      'Terapia de Liberación Espiritual (SRT)',
    ],
    worksFor: { '@id': `${SITE_URL}/#organization` },
  },
]);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/png" href="/icon-192.png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="theme-color" content="#0E1514" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,600&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Newsreader:ital,opsz,wght@1,6..72,300;1,6..72,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Syne:wght@400;500;600;700&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
	rel="stylesheet"
/>

<link rel="canonical" href={canonicalURL} />

<title>{headTitle}</title>
<meta name="title" content={headTitle} />
<meta name="description" content={description} />

<meta property="og:type" content={ogType} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:alt" content={`${title} — Regresión a Vidas Pasadas`} />
<meta property="og:site_name" content="Regresión a Vidas Pasadas" />
<meta property="og:locale" content="es_LA" />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImage} />

<!-- Sitewide entity schemas: Organization + Person -->
<script type="application/ld+json" set:html={siteSchemas}></script>

---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const allPosts = await getCollection('blog');

const JP = 'https://www.juanpabloloaiza.com';
const JP_FOTO = 'https://media.juanpabloloaiza.com/images/jpl-newwsp.jpeg';
const JP_WHATSAPP = 'https://api.whatsapp.com/send?phone=56962081884&text=' +
  encodeURIComponent('Hola Juan Pablo, te escribo desde la página de expositores de regresionvidaspasadas.com.');

const EXPOSITORES = [
  {
    slug: 'brian-weiss',
    nombre: 'Brian Weiss',
    periodo: '1944 –',
    disciplina: 'Psiquiatría · Regresión clínica',
    descripcion: 'Psiquiatra de Yale y Mount Sinai. Su caso con la paciente Catherine —documentado en "Muchas Vidas, Muchos Maestros" (1988)— convirtió la regresión terapéutica en un fenómeno mundial.',
    libro: 'Muchas Vidas, Muchos Maestros (1988)',
  },
  {
    slug: 'juan-pablo-loaiza',
    destacado: true,
    nombre: 'Juan Pablo Loaiza',
    periodo: 'Terapeuta en ejercicio',
    disciplina: 'Regresión a Vidas Pasadas · Hipnosis clínica · SRT',
    descripcion: 'Terapeuta de Regresión a Vidas Pasadas (TRVP) con más de 19 años de experiencia. Realiza sesiones de regresión, hipnosis clínica y Terapia de Liberación Espiritual (SRT), de forma online para personas de todo el mundo, y escribe este portal.',
    libro: '',
    enlaces: [
      { texto: 'Su sitio web', detalle: 'juanpabloloaiza.com', href: JP },
      { texto: 'Sesiones de regresión a vidas pasadas', detalle: 'Cómo funciona el proceso', href: `${JP}/#QueEsTRVP` },
      { texto: 'Liberación espiritual (SRT)', detalle: 'Qué es y cómo se trabaja', href: `${JP}/#liberacion` },
      { texto: 'Su blog', detalle: 'Artículos de Juan Pablo', href: `${JP}/blog` },
      { texto: 'Videos', detalle: 'Contenido en video', href: `${JP}/videos` },
      { texto: 'Escríbele por WhatsApp', detalle: 'Consultas y sesiones', href: JP_WHATSAPP },
    ],
  },
  {
    slug: 'michael-newton',
    nombre: 'Michael Newton',
    periodo: '1931 – 2016',
    disciplina: 'Hipnoterapia · Vida entre Vidas',
    descripcion: 'Psicólogo clínico y maestro hipnoterapeuta. Desarrolló la Life Between Lives (LBL): el estudio sistemático de lo que el alma experimenta entre una encarnación y la siguiente.',
    libro: 'Journey of Souls (1994)',
  },
  {
    slug: 'dolores-cannon',
    nombre: 'Dolores Cannon',
    periodo: '1931 – 2014',
    disciplina: 'Hipnoterapia · QHHT',
    descripcion: 'Hipnoterapeuta autodidacta que creó el Quantum Healing Hypnosis Technique (QHHT). Autora de más de 20 libros y fundadora de Ozark Mountain Publishing.',
    libro: 'The Convoluted Universe (2001–2012)',
  },
  {
    slug: 'roger-woolger',
    nombre: 'Roger Woolger',
    periodo: '1944 – 2011',
    disciplina: 'Psicología junguiana · Deep Memory Process',
    descripcion: 'Analista junguiano de Oxford. Integró la psicología profunda de Jung con la regresión, creando el Deep Memory Process y el marco teórico más riguroso del campo.',
    libro: 'Other Lives, Other Selves (1987)',
  },
  {
    slug: 'ian-stevenson',
    nombre: 'Ian Stevenson',
    periodo: '1918 – 2007',
    disciplina: 'Psiquiatría · Investigación científica',
    descripcion: 'Psiquiatra de la Universidad de Virginia. Investigó durante 40 años más de 3.000 casos de niños con recuerdos espontáneos de vidas pasadas. La evidencia más sólida y verificable del campo.',
    libro: 'Veinte Casos Sugestivos de Reencarnación (1966)',
  },
  {
    slug: 'helen-wambach',
    nombre: 'Helen Wambach',
    periodo: '1925 – 1986',
    disciplina: 'Psicología clínica · Investigación estadística',
    descripcion: 'Psicóloga clínica. Condujo sesiones de hipnosis grupal con más de 1.000 sujetos y analizó estadísticamente los patrones de sus regresiones. Única investigadora del campo que comenzó desde el escepticismo explícito.',
    libro: 'Reliving Past Lives (1978)',
  },
  {
    slug: 'carl-wickland',
    nombre: 'Carl Wickland',
    periodo: '1861 – 1945',
    disciplina: 'Psiquiatría · Liberación espiritual (SRT)',
    descripcion: 'Psiquiatra sueco-estadounidense que dedicó más de 30 años, junto a su esposa Anna como médium, a estudiar el apego espiritual como posible causa de trastornos mentales. Su libro de 1924 es el texto fundacional de la Terapia de Liberación Espiritual.',
    libro: 'Thirty Years Among the Dead (1924)',
  },
  {
    slug: 'william-baldwin',
    nombre: 'William Baldwin',
    periodo: '1939 – 2004',
    disciplina: 'Odontología · Psicología clínica · SRT',
    descripcion: 'Dentista y psicólogo clínico que llegó a la liberación espiritual desde la hipnosis. Sistematizó la Terapia de Liberación Espiritual en un manual de 1992 con protocolos para cada tipo de entidad.',
    libro: 'Spirit Releasement Therapy (1992)',
  },
  {
    slug: 'edith-fiore',
    nombre: 'Edith Fiore',
    periodo: 'Práctica clínica desde los años 70',
    disciplina: 'Psicología clínica · Hipnosis · SRT',
    descripcion: 'Psicóloga clínica con doctorado de la Universidad de Miami y más de treinta años de práctica en California. Llegó a la liberación espiritual desde la práctica clínica y la hipnosis, y documentó sus casos con rigor profesional.',
    libro: 'The Unquiet Dead (1987)',
  },
  {
    slug: 'alan-sanderson',
    nombre: 'Alan Sanderson',
    periodo: 'Médico desde 1954',
    disciplina: 'Psiquiatría · Liberación espiritual (SRT)',
    descripcion: 'Psiquiatra consultor del NHS británico, formado en el Hospital St. Thomas de Londres. Introdujo la liberación espiritual en la medicina institucional y cofundó en el año 2000 la Spirit Release Foundation, que operó hasta 2013.',
    libro: 'Psychiatry and the Spirit World',
  },
];

function getArticulosPorExpositor(slug: string) {
  return allPosts
    .filter(p => p.data.expositor === slug)
    .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
}

const SITEURL = 'https://www.regresionvidaspasadas.com';
const HUB_URL = `${SITEURL}/expositores/`;

const expositorSlugs = EXPOSITORES.map(e => e.slug);
const expositorPosts = allPosts
  .filter(p => p.data.expositor && expositorSlugs.includes(p.data.expositor))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

const expositoresSchema = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${HUB_URL}#collectionpage`,
    name: 'Investigadores de la Regresión a Vidas Pasadas',
    description: 'Perfiles de los investigadores y terapeutas más influyentes de la regresión a vidas pasadas y la liberación espiritual: Brian Weiss, Michael Newton, Dolores Cannon, Roger Woolger, Ian Stevenson, Helen Wambach, Carl Wickland, William Baldwin, Edith Fiore y Alan Sanderson, además de Juan Pablo Loaiza.',
    url: HUB_URL,
    inLanguage: 'es',
    publisher: { '@id': `${SITEURL}/#organization` },
    mentions: EXPOSITORES.map(e => (e.destacado
      ? { '@type': 'Person', '@id': `${JP}/#person`, name: e.nombre, description: e.descripcion, url: JP }
      : { '@type': 'Person', name: e.nombre, description: e.descripcion })),
    hasPart: expositorPosts.map(p => ({
      '@type': 'Article',
      '@id': `${SITEURL}/blog/${p.id}/#article`,
      name: p.data.title,
      url: `${SITEURL}/blog/${p.id}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITEURL },
      { '@type': 'ListItem', position: 2, name: 'Expositores', item: HUB_URL },
    ],
  },
]);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title="Expositores de la Regresión a Vidas Pasadas"
      description="Los investigadores y terapeutas más influyentes de la regresión a vidas pasadas y la liberación espiritual: Brian Weiss, Michael Newton, Dolores Cannon, Roger Woolger, Ian Stevenson, Helen Wambach, Carl Wickland, William Baldwin, Edith Fiore y Alan Sanderson."
    />
    <script type="application/ld+json" set:html={expositoresSchema}></script>
  </head>
  <body>
    <Header />
    <main class="page-wrap">
      <div class="page-header">
        <span class="ornament">✦</span>
        <h1>Grandes Expositores</h1>
        <p class="page-desc">
          Los investigadores, terapeutas y académicos que definieron el campo de la
          regresión a vidas pasadas y de la liberación espiritual. Sus metodologías y sus obras son el fundamento
          de lo que hoy entendemos sobre este proceso.
        </p>
        <div class="divider"></div>
      </div>

      {EXPOSITORES.map(exp => {
        const articulos = getArticulosPorExpositor(exp.slug);
        return (
          <section class:list={['expositor-section', { 'expositor-section--destacado': exp.destacado }]}>
            <div class="expositor-header">
              <div class="expositor-meta">
                <span class="expositor-periodo">{exp.periodo}</span>
                <span class="expositor-disciplina">{exp.disciplina}</span>
              </div>
              {exp.destacado ? (
                <div class="expositor-perfil">
                  <img class="expositor-foto" src={JP_FOTO} alt="Juan Pablo Loaiza, terapeuta de Regresión a Vidas Pasadas" width="132" height="132" loading="lazy" decoding="async" />
                  <div>
                    <h2 class="expositor-nombre"><a href={JP} rel="author">{exp.nombre}</a></h2>
                    <p class="expositor-desc">{exp.descripcion}</p>
                    <ul class="expositor-datos">
                      <li>+19 años de experiencia</li>
                      <li>Regresión a vidas pasadas</li>
                      <li>Terapia de Liberación Espiritual (SRT)</li>
                      <li>Sesiones online en todo el mundo</li>
                    </ul>
                  </div>
                </div>
              ) : (
                <>
                  <h2 class="expositor-nombre">{exp.nombre}</h2>
                  <p class="expositor-desc">{exp.descripcion}</p>
                  <p class="expositor-libro">
                    <span class="libro-label">Obra principal:</span> {exp.libro}
                  </p>
                </>
              )}
            </div>

            {exp.destacado && (
              <ul class="articulos-grid">
                {exp.enlaces.map(l => (
                  <li>
                    <a href={l.href} class="articulo-card" target="_blank" rel="noopener">
                      <span class="art-title">{l.texto}<small class="art-detalle">{l.detalle}</small></span>
                      <span class="art-arrow">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}

            {articulos.length > 0 && (
              <ul class="articulos-grid">
                {articulos.map(art => (
                  <li>
                    <a href={`/blog/${art.id}/`} class="articulo-card">
                      <span class="art-title">{art.data.title}</span>
                      <span class="art-arrow">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        );
      })}
    </main>
    <Footer />
  </body>
</html>

<style>
  .page-wrap {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1.5em 4em;
  }

  .page-header {
    text-align: center;
    padding: 3em 0 2em;
  }

  .ornament {
    display: block;
    color: #F5DC98;
    font-size: 0.9em;
    letter-spacing: 0.4em;
    margin-bottom: 1em;
  }

  .page-header h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.4em;
    font-weight: 400;
    color: #FAF7F2;
    margin-bottom: 0.6em;
  }

  .page-desc {
    max-width: 560px;
    margin: 0 auto 1.5em;
    color: #C6C0B1;
    font-size: 1.05em;
    line-height: 1.7;
  }

  .divider {
    width: 60px;
    height: 1px;
    background: linear-gradient(90deg, transparent, #F5DC98, transparent);
    margin: 0 auto;
  }

  .expositor-section--destacado {
    background: linear-gradient(160deg, rgba(27,38,37,0.7), rgba(9,14,13,0.85));
    border: 1px solid rgba(230,200,117,0.35);
    border-radius: 18px;
    padding: 1.75em 1.75em 1.5em;
    box-shadow: 0 10px 35px -10px rgba(0,0,0,0.6), 0 0 0 1px rgba(230,200,117,0.06);
  }
  .expositor-perfil { display: flex; gap: 1.5em; align-items: flex-start; }
  .expositor-foto {
    flex-shrink: 0;
    width: 132px; height: 132px;
    border-radius: 50%;
    object-fit: cover; object-position: 50% 22%;
    border: 3px solid #E6C875;
    box-shadow: 0 4px 16px rgba(230,200,117,0.25);
  }
  .expositor-nombre a { color: inherit; text-decoration: none; }
  .expositor-nombre a:hover { color: #E6C875; }
  .expositor-datos {
    list-style: none; margin: 0.9em 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 0.5em 0.6em;
  }
  .expositor-datos li {
    font-family: 'Syne', sans-serif;
    font-size: 0.5em; letter-spacing: 0.12em; text-transform: uppercase;
    color: #E6C875;
    border: 1px solid rgba(230,200,117,0.35);
    border-radius: 999px;
    padding: 0.5em 1em;
  }
  .art-detalle {
    display: block;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.68em; font-weight: 400;
    color: rgba(250,247,242,0.6);
    margin-top: 0.15em;
  }
  @media (max-width: 640px) {
    .expositor-perfil { flex-direction: column; align-items: center; text-align: center; }
    .expositor-datos { justify-content: center; }
  }

  .expositor-section {
    margin-top: 3.5em;
    padding-top: 3em;
    border-top: 1px solid rgba(230, 200, 117, 0.15);
  }

  .expositor-header {
    margin-bottom: 1.75em;
  }

  .expositor-meta {
    display: flex;
    gap: 1em;
    margin-bottom: 0.5em;
    flex-wrap: wrap;
  }

  .expositor-periodo,
  .expositor-disciplina {
    font-family: 'Syne', serif;
    font-size: 0.68em;
    letter-spacing: 0.12em;
    color: #BA9C4B;
    text-transform: uppercase;
  }

  .expositor-disciplina::before {
    content: '·';
    margin-right: 1em;
    color: #E6C875;
  }

  .expositor-nombre {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.85em;
    font-weight: 400;
    color: #FAF7F2;
    margin-bottom: 0.6em;
    line-height: 1.2;
  }

  .expositor-desc {
    color: #D9D3C5;
    line-height: 1.7;
    margin-bottom: 0.75em;
    font-size: 0.97em;
  }

  .expositor-libro {
    font-size: 0.85em;
    color: #E6C875;
    font-style: italic;
  }

  .libro-label {
    font-style: normal;
    font-family: 'Syne', serif;
    font-size: 0.85em;
    letter-spacing: 0.06em;
    color: #BA9C4B;
    margin-right: 0.35em;
  }

  .articulos-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5em;
  }

  .articulo-card {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5em;
    padding: 0.75em 1em;
    background: #151E1D;
    border-radius: 12px;
    text-decoration: none;
    border: 1px solid transparent;
    transition: border-color 0.2s, background 0.2s;
  }

  .articulo-card:hover {
    border-color: rgba(230, 200, 117, 0.3);
    background: #1B2625;
  }

  .art-title {
    font-size: 0.85em;
    color: #FAF7F2;
    line-height: 1.4;
  }

  .art-arrow {
    color: #E6C875;
    flex-shrink: 0;
    font-size: 0.85em;
  }

  @media (max-width: 600px) {
    .articulos-grid {
      grid-template-columns: 1fr;
    }
    .page-header h1 { font-size: 1.8em; }
    .expositor-nombre { font-size: 1.5em; }
  }
</style>

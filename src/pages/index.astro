---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchModal from '../components/SearchModal.astro';
import LogoMark from '../components/LogoMark.astro';
import { SITE_DESCRIPTION, SITE_TITLE, CATEGORY, EDITORIAL_PICKS, FEATURED_SLUG, SLUG_IMG } from '../consts';

import heroImg        from '../assets/blog/stitch-hero-meditacion.png';
import imgVelasSeance from '../assets/blog/srt-velas-seance.jpg';
import imgVelaOscuridad from '../assets/blog/srt-vela-oscuridad.jpg';
import imgManosLuz    from '../assets/blog/srt-manos-luz.jpg';
import imgOjoMistico  from '../assets/blog/hipnosis-ojo-mistico.jpg';
import imgMeditacion  from '../assets/blog/rvp-meditacion.jpg';
import imgDefault     from '../assets/blog/stitch-hero-meditacion.png';
import imgCosmos      from '../assets/blog/cosmos-estrellas.jpg';
import imgHumoOscuro  from '../assets/blog/srt-humo-oscuro.jpg';
import imgTerapia     from '../assets/blog/terapia-sesion.jpg';
import imgPortalLuz   from '../assets/blog/portal-luz.jpg';
import imgNinos       from '../assets/blog/ninos-naturaleza.jpg';
import imgMeditGrupal from '../assets/blog/meditacion-grupal.jpg';
import imgRitualFuego from '../assets/blog/ritual-fuego.jpg';
import imgSilueta     from '../assets/blog/silueta-espiritual.jpg';
import imgQueEs       from '../assets/blog/que-es-regresion.jpg';
import imgBeneficios  from '../assets/blog/beneficios-regresion.jpg';
import imgSesion      from '../assets/blog/sesion-regresion.jpg';
import type { ImageMetadata } from 'astro';

const IMG_REGISTRY: Record<string, ImageMetadata> = {
  'srt-velas-seance':        imgVelasSeance,
  'srt-vela-oscuridad':      imgVelaOscuridad,
  'srt-manos-luz':           imgManosLuz,
  'hipnosis-ojo-mistico':    imgOjoMistico,
  'rvp-meditacion':          imgMeditacion,
  'hero-meditacion-amanecer': imgDefault,
  'cosmos-estrellas':        imgCosmos,
  'srt-humo-oscuro':         imgHumoOscuro,
  'terapia-sesion':          imgTerapia,
  'portal-luz':              imgPortalLuz,
  'ninos-naturaleza':        imgNinos,
  'meditacion-grupal':       imgMeditGrupal,
  'ritual-fuego':            imgRitualFuego,
  'silueta-espiritual':      imgSilueta,
  'que-es-regresion':        imgQueEs,
  'beneficios-regresion':    imgBeneficios,
  'sesion-regresion':        imgSesion,
};

const EXPOSITOR_IMG: Record<string, ImageMetadata> = {
  'carl-wickland':   imgVelasSeance,
  'william-baldwin': imgManosLuz,
  'edith-fiore':     imgMeditacion,
  'alan-sanderson':  imgMeditacion,
  'srt':             imgVelaOscuridad,
  'hipnosis':        imgOjoMistico,
};

function getPostImage(id: string, heroImage: ImageMetadata | undefined, expositor?: string): ImageMetadata {
  if (heroImage) return heroImage;
  if (SLUG_IMG[id] && IMG_REGISTRY[SLUG_IMG[id]]) return IMG_REGISTRY[SLUG_IMG[id]];
  if (expositor && EXPOSITOR_IMG[expositor]) return EXPOSITOR_IMG[expositor];
  return imgDefault;
}

const allPosts = await getCollection('blog');
const postCount = allPosts.length;
const expositorCount = new Set(allPosts.map(p => p.data.expositor).filter((e) => e && e !== 'srt' && e !== 'hipnosis')).size;

const featuredPost = allPosts.find(p => p.id === FEATURED_SLUG);
const featuredCat = featuredPost?.data.expositor ? CATEGORY[featuredPost.data.expositor] : undefined;
const featuredImg = featuredPost
  ? getPostImage(featuredPost.id, featuredPost.data.heroImage, featuredPost.data.expositor)
  : imgDefault;

const recentPosts = allPosts
  .filter(p => p.id !== FEATURED_SLUG)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const topPosts = EDITORIAL_PICKS
  .map(s => allPosts.find(p => p.id === s))
  .filter((p): p is NonNullable<typeof p> => p != null)
  .slice(0, 4);

const casePost = allPosts.find(p => p.id === EDITORIAL_PICKS[1]) ?? topPosts[1];

const EXPEDIENTES = [
  { icon: 'history_edu', title: 'Regresión a Vidas Pasadas', desc: 'Investigación sobre memorias transgeneracionales y la continuidad de la consciencia a través del tiempo.', href: '/expositores', cta: 'Ver investigadores' },
  { icon: 'auto_awesome', title: 'Terapia de Liberación Espiritual', desc: 'Sistemas de limpieza energética y liberación de entidades adheridas al campo humano. Documentado desde 1924.', href: '/srt', cta: 'Explorar SRT' },
  { icon: 'psychology', title: 'Hipnosis Clínica', desc: 'Técnicas de inducción al subconsciente aplicadas al bienestar terapéutico y resolución de traumas.', href: '/hipnosis', cta: 'Explorar hipnosis' },
  { icon: 'menu_book', title: 'Biblioteca Editorial', desc: 'Libros esenciales: Brian Weiss, Michael Newton, Dolores Cannon, William Baldwin y más.', href: '/libros', cta: 'Ver biblioteca' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead title="Regresión a Vidas Pasadas: guía, expositores y método" description={SITE_DESCRIPTION} />
    <style>
      /* Material Symbols */
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        font-family: 'Material Symbols Outlined';
        font-size: inherit;
        line-height: 1;
        display: inline-block;
        vertical-align: middle;
      }
    </style>
  </head>
  <body>
    <Header />
    <SearchModal />

    <!-- ① HERO (diseño Stitch · Variante 03) -->
    <section class="home-hero">
      <div class="home-hero-glow" aria-hidden="true"></div>
      <div class="home-hero-inner">
        <div class="home-hero-copy">
          <div class="home-hero-badge">
            <span class="home-hero-dot" aria-hidden="true"></span>
            <span class="home-hero-badge-text">Portada Editorial</span>
          </div>
          <h1 class="home-hero-title">La memoria del alma<br/>a través del <em>tiempo</em></h1>
          <p class="home-hero-subtitle">
            Una exploración académica sobre la regresión, la hipnosis y la liberación espiritual en la consciencia contemporánea.
          </p>
          <div class="home-hero-actions">
            <a class="hero-btn hero-btn--primary" href="#portal">Explorar el portal</a>
            <a class="hero-btn hero-btn--ghost" href="/blog/">Leer artículos</a>
          </div>
          <dl class="home-hero-stats">
            <div><dt>{postCount}</dt><dd>Artículos</dd></div>
            <span class="home-hero-sep" aria-hidden="true"></span>
            <div><dt>{expositorCount}</dt><dd>Expositores</dd></div>
            <span class="home-hero-sep" aria-hidden="true"></span>
            <div><dt class="home-hero-stat-italic">Hipnosis · Regresión · SRT</dt><dd>Disciplinas</dd></div>
          </dl>
        </div>

        <div class="home-hero-visual">
          <div class="home-hero-arch-glow" aria-hidden="true"></div>
          <div class="home-hero-arch">
            <Image src={heroImg} alt="Persona meditando sobre una cumbre al amanecer" width={900} height={1100} class="home-hero-img" loading="eager" />
            <div class="home-hero-arch-shade" aria-hidden="true"></div>
            <span class="home-hero-spark home-hero-spark--a" aria-hidden="true"></span>
            <span class="home-hero-spark home-hero-spark--b" aria-hidden="true"></span>
            <span class="home-hero-spark home-hero-spark--c" aria-hidden="true"></span>
          </div>
          <div class="home-hero-card">
            <LogoMark size={34} />
            <div>
              <span class="home-hero-card-label">Portal editorial</span>
              <span class="home-hero-card-text">Archivo de la consciencia continua</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <main class="home-main" id="portal">

      <!-- Meta bar académica -->
      <div class="home-meta-bar">
        <span class="home-meta-left">Portal Independiente · Más de 60 artículos</span>
        <span class="home-meta-right">Investigación en RVP · SRT · Hipnosis Clínica</span>
      </div>

      <!-- Grid editorial: 8 columnas contenido + 4 columnas sidebar -->
      <div class="home-grid">

        <!-- Contenido principal -->
        <div class="home-main-col">

          <!-- ARTÍCULO DESTACADO -->
          {featuredPost && (
            <article class="featured-article">
              <div class="featured-img-wrap">
                <Image src={featuredImg} alt={featuredPost.data.title} width={640} height={640} class="featured-img" loading="eager" />
              </div>
              <div class="featured-body">
                {featuredCat && (
                  <span class="featured-cat" style={`color: ${featuredCat.color}`}>{featuredCat.label}</span>
                )}
                <h2 class="featured-title">
                  <a href={`/blog/${featuredPost.id}/`}>{featuredPost.data.title}</a>
                </h2>
                <p class="featured-excerpt drop-cap">{featuredPost.data.description}</p>
                <a class="featured-read-more" href={`/blog/${featuredPost.id}/`}>
                  Continuar lectura <span class="material-symbols-outlined" style="font-size:0.9em">arrow_forward</span>
                </a>
              </div>
            </article>
          )}

          <!-- ARTÍCULOS SECUNDARIOS (2 columnas) -->
          <div class="secondary-grid">
            {recentPosts[0] && (() => {
              const cat = recentPosts[0].data.expositor ? CATEGORY[recentPosts[0].data.expositor] : undefined;
              const img = getPostImage(recentPosts[0].id, recentPosts[0].data.heroImage, recentPosts[0].data.expositor);
              return (
                <article class="secondary-card">
                  <div class="secondary-img-wrap">
                    <Image src={img} alt={recentPosts[0].data.title} width={480} height={270} class="secondary-img" loading="lazy" />
                  </div>
                  <h3 class="secondary-title">
                    <a href={`/blog/${recentPosts[0].id}/`}>{recentPosts[0].data.title}</a>
                  </h3>
                  <p class="secondary-desc">{recentPosts[0].data.description}</p>
                  {cat && <span class="secondary-cat">{cat.label}</span>}
                </article>
              );
            })()}

            {recentPosts[1] && (
              <article class="secondary-card secondary-card--text">
                <div class="secondary-icon-wrap">
                  <span class="material-symbols-outlined secondary-icon">psychology</span>
                </div>
                <h3 class="secondary-title">
                  <a href={`/blog/${recentPosts[1].id}/`}>{recentPosts[1].data.title}</a>
                </h3>
                <p class="secondary-desc">{recentPosts[1].data.description}</p>
                <span class="secondary-cat-label">Artículo · Investigación</span>
              </article>
            )}
          </div>

          <!-- ESTUDIO DE CASO (beige, horizontal) -->
          {casePost && (
            <article class="case-card">
              <div class="case-body">
                <span class="case-label">Lectura esencial</span>
                <h3 class="case-title">{casePost.data.title}</h3>
                <p class="case-quote">"{casePost.data.description}"</p>
              </div>
              <a href={`/blog/${casePost.id}/`} class="case-btn">Ver artículo</a>
            </article>
          )}

        </div>

        <!-- SIDEBAR -->
        <aside class="home-sidebar">

          <!-- Newsletter -->
          <div class="sidebar-newsletter">
            <div class="sidebar-newsletter-icon">
              <span class="material-symbols-outlined">mail</span>
            </div>
            <h4 class="sidebar-newsletter-title">Boletín de Investigación</h4>
            <p class="sidebar-newsletter-desc">Reciba mensualmente los últimos hallazgos sobre RVP, SRT y estudios de la consciencia.</p>
            <form class="sidebar-newsletter-form" id="newsletter-form-home">
              <input class="sidebar-newsletter-input" type="email" placeholder="Correo electrónico" required />
              <button class="sidebar-newsletter-btn" type="submit">Suscribirse al Portal</button>
              <p class="newsletter-msg" id="newsletter-msg-home" aria-live="polite"></p>
            </form>
          </div>

          <!-- Lo más leído -->
          <div class="sidebar-mostread">
            <h4 class="sidebar-section-title">Lo más leído</h4>
            <ol class="sidebar-mostread-list">
              {topPosts.map((post, i) => (
                <li class="sidebar-mostread-item">
                  <span class="sidebar-mostread-num">0{i + 1}</span>
                  <a href={`/blog/${post.id}/`} class="sidebar-mostread-link">{post.data.title}</a>
                </li>
              ))}
            </ol>
          </div>

          <!-- CTA especialista (reemplaza "Podcast Editorial") -->
          <div class="sidebar-cta-dark">
            <span class="sidebar-cta-eyebrow">Trabajo personal</span>
            <h4 class="sidebar-cta-title">Sesiones con un especialista</h4>
            <p class="sidebar-cta-desc">Explora el proceso de regresión con un terapeuta certificado en RVP.</p>
            <a href="https://www.juanpabloloaiza.com/#QueEsTRVP" target="_blank" rel="noopener" class="sidebar-cta-link">
              Sesiones de regresión con Juan Pablo Loaiza →
            </a>
          </div>

        </aside>
      </div>

      <div class="home-ornament"></div>

      <!-- EXPEDIENTES (4 cards grid) -->
      <section class="expedientes-section">
        <div class="expedientes-header">
          <h2 class="expedientes-title">Disciplinas del Portal</h2>
          <div class="expedientes-line"></div>
        </div>
        <div class="expedientes-grid">
          {EXPEDIENTES.map(e => (
            <a href={e.href} class="expediente-card">
              <span class="material-symbols-outlined expediente-icon">{e.icon}</span>
              <h5 class="expediente-title">{e.title}</h5>
              <p class="expediente-desc">{e.desc}</p>
              <span class="expediente-cta">{e.cta}</span>
            </a>
          ))}
        </div>
      </section>

    </main>
    <Footer />

    <script>
      function setupNewsletter(formId: string, msgId: string) {
        const form = document.getElementById(formId) as HTMLFormElement | null;
        const msg = document.getElementById(msgId) as HTMLElement | null;
        if (!form || !msg) return;
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const input = form.querySelector('input[type="email"]') as HTMLInputElement;
          const btn = form.querySelector('button') as HTMLButtonElement;
          const email = input?.value.trim();
          if (!email) return;
          btn.disabled = true;
          btn.textContent = 'Enviando…';
          try {
            const res = await fetch('/api/subscribe', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email }),
            });
            const data = await res.json();
            if (res.ok) {
              msg.textContent = data.message ?? '¡Suscrito!';
              msg.style.color = '#B8952A';
              input.value = '';
              btn.textContent = '✓ Suscrito';
            } else {
              msg.textContent = data.error ?? 'Error. Intente nuevamente.';
              msg.style.color = '#c0392b';
              btn.disabled = false;
              btn.textContent = 'Suscribirse al Portal';
            }
          } catch {
            msg.textContent = 'Error de conexión.';
            msg.style.color = '#c0392b';
            btn.disabled = false;
            btn.textContent = 'Suscribirse al Portal';
          }
        });
      }
      setupNewsletter('newsletter-form-home', 'newsletter-msg-home');
    </script>
  </body>
</html>

<style>
  /* ——— Hero (diseño Stitch · Variante 03) ——— */
  .home-hero {
    position: relative;
    width: 100%;
    min-height: calc(100svh - 77px);
    display: flex;
    align-items: center;
    overflow: hidden;
    box-sizing: border-box;
    padding: 3em 2em 4em;
  }

  .home-hero-glow {
    position: absolute;
    top: -6%; right: 4%;
    width: 640px; height: 640px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(230,200,117,0.16) 0%, rgba(14,21,20,0) 70%);
    filter: blur(24px);
    pointer-events: none;
  }

  .home-hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 3.5em;
    align-items: center;
  }

  .home-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.45em 1.2em;
    background: rgba(230,200,117,0.07);
    border: 1px solid rgba(230,200,117,0.35);
    border-radius: 999px;
    margin-bottom: 1.8em;
  }
  .home-hero-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #E6C875;
    box-shadow: 0 0 8px #E6C875;
  }
  .home-hero-badge-text {
    font-family: 'Syne', sans-serif;
    font-size: 0.5em;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #E6C875;
  }

  .home-hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.3em, 4.3vw, 3.7em);
    font-weight: 300;
    color: #FAF7F2;
    line-height: 1.1;
    letter-spacing: -0.005em;
    margin: 0 0 0.55em;
  }
  .home-hero-title em {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-weight: 400;
    color: #F5DC98;
    text-decoration: underline;
    text-decoration-color: rgba(230,200,117,0.35);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .home-hero-subtitle {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-size: clamp(1em, 1.45vw, 1.2em);
    color: rgba(250,247,242,0.72);
    line-height: 1.5;
    max-width: 34em;
    margin: 0 0 1.9em;
  }

  .home-hero-actions { display: flex; flex-wrap: wrap; gap: 1em; margin-bottom: 2.4em; }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.95em 1.9em;
    border-radius: 999px;
    font-family: 'Syne', sans-serif;
    font-size: 0.55em;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s, border-color .2s;
  }
  .hero-btn:hover { text-decoration: none; }
  .hero-btn--primary {
    background: linear-gradient(135deg, #F5DC98 0%, #E6C875 50%, #C99F44 100%);
    color: #0E1514;
    box-shadow: 0 4px 24px rgba(230,200,117,0.35);
  }
  .hero-btn--primary:hover { color: #0E1514; transform: translateY(-2px); box-shadow: 0 8px 30px rgba(230,200,117,0.5); }
  .hero-btn--ghost {
    border: 1px solid rgba(230,200,117,0.45);
    color: #FAF7F2;
  }
  .hero-btn--ghost:hover { color: #E6C875; border-color: #E6C875; background: rgba(230,200,117,0.08); }

  .home-hero-stats {
    display: flex;
    align-items: center;
    gap: 1.6em;
    margin: 0;
    padding-top: 1.6em;
    border-top: 1px solid rgba(230,200,117,0.2);
    max-width: 34em;
  }
  .home-hero-stats div { display: flex; flex-direction: column; gap: 0.35em; }
  .home-hero-stats dt {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.35em;
    font-weight: 600;
    line-height: 1;
    color: #FAF7F2;
    margin: 0;
  }
  .home-hero-stats dt.home-hero-stat-italic {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 0.85em;
    color: #F5DC98;
  }
  .home-hero-stats dd {
    font-family: 'Syne', sans-serif;
    font-size: 0.43em;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(250,247,242,0.6);
    margin: 0;
  }
  .home-hero-sep { width: 1px; height: 2em; background: rgba(230,200,117,0.25); }

  /* Foto con degradado (se funde con el fondo) */
  .home-hero-visual {
    position: relative;
    justify-self: end;
    width: min(100%, 600px);
    aspect-ratio: 1 / 1.02;
  }
  .home-hero-arch-glow {
    position: absolute;
    inset: 6% 2% 6% 8%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(230,200,117,0.22) 0%, rgba(230,200,117,0.05) 55%, transparent 75%);
    filter: blur(30px);
  }
  .home-hero-arch {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 28px;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 34%),
      linear-gradient(to top, transparent 0%, #000 26%),
      linear-gradient(to bottom, transparent 0%, #000 14%);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent 0%, #000 34%),
      linear-gradient(to top, transparent 0%, #000 26%),
      linear-gradient(to bottom, transparent 0%, #000 14%);
    mask-composite: intersect;
  }
  .home-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
    filter: brightness(0.95) contrast(1.05);
    display: block;
  }
  .home-hero-arch-shade {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 70% 45%, transparent 40%, rgba(14,21,20,0.55) 100%);
    pointer-events: none;
  }
  .home-hero-spark {
    position: absolute;
    width: 5px; height: 5px; border-radius: 50%;
    background: #F5DC98;
    box-shadow: 0 0 8px #F5DC98;
    opacity: 0.8;
  }
  .home-hero-spark--a { top: 26%; left: 34%; }
  .home-hero-spark--b { top: 34%; right: 24%; width: 4px; height: 4px; }
  .home-hero-spark--c { top: 66%; right: 32%; }

  .home-hero-card {
    position: absolute;
    left: -2.2em;
    bottom: -1.2em;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.9em;
    max-width: 17.5em;
    padding: 0.9em 1.3em;
    background: rgba(14,21,20,0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(230,200,117,0.25);
    border-radius: 18px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.65);
  }
  .home-hero-card > div { display: flex; flex-direction: column; gap: 0.2em; }
  .home-hero-card-label {
    font-family: 'Syne', sans-serif;
    font-size: 0.42em;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #E6C875;
  }
  .home-hero-card-text {
    font-family: 'Newsreader', serif;
    font-style: italic;
    font-size: 0.78em;
    line-height: 1.25;
    color: #FAF7F2;
  }


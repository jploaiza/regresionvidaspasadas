---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import headerImg from '../assets/blog/peliculas-cine-film.jpg';
import fs from 'node:fs';
import path from 'node:path';

const CATEGORIAS = [
  {
    titulo: 'Vida después de la muerte',
    icono: '✨',
    items: [
      {
        titulo: 'Hereafter',
        tipo: 'Película',
        año: '2010',
        origen: 'EE.UU.',
        descripcion: 'Tres historias conectadas sobre la experiencia cercana a la muerte: una mujer francesa que sobrevive al tsunami de 2004, un niño que busca contactar a su hermano muerto, y un médium americano que quiere liberarse de su don.',
        porque: 'Una exploración cinematográfica inusualmente honesta y no sensacionalista de la comunicación con los muertos y las NDE.',
      },
      {
        titulo: 'What Dreams May Come',
        tipo: 'Película',
        año: '1998',
        origen: 'EE.UU.',
        descripcion: 'Un hombre muere en un accidente y descubre los planos del más allá mientras intenta rescatar a su esposa del infierno de su propio dolor. Basada en la novela de Richard Matheson.',
        porque: 'Visualmente impresionante y emocionalmente poderosa. Explora la idea de que el más allá es co-creado por nuestra mente.',
      },
      {
        titulo: 'Defending Your Life',
        slug: 'defending-your-life',
        tipo: 'Película',
        año: '1991',
        origen: 'EE.UU.',
        descripcion: 'Tras morir, un hombre llega a Ciudad del Juicio, donde debe defender sus decisiones ante un tribunal para ver si avanza. Comedia escrita y dirigida por Albert Brooks, con Meryl Streep.',
        porque: 'Con humor, plantea que el miedo es lo que más pesa en una vida; una idea afín a la revisión de vida que describen Newton y otros.',
      },
      {
        titulo: 'Heaven Is for Real',
        slug: 'heaven-is-for-real',
        tipo: 'Película',
        año: '2014',
        origen: 'EE.UU.',

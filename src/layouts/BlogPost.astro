---
import { Image } from 'astro:assets';
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import ShareButtons from '../components/ShareButtons.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORY, SLUG_IMG } from '../consts';

import imgVelasSeance    from '../assets/blog/srt-velas-seance.jpg';
import imgVelaOscuridad  from '../assets/blog/srt-vela-oscuridad.jpg';
import imgManosLuz       from '../assets/blog/srt-manos-luz.jpg';
import imgOjoMistico     from '../assets/blog/hipnosis-ojo-mistico.jpg';
import imgMeditacion     from '../assets/blog/rvp-meditacion.jpg';
import imgDefault        from '../assets/blog/hero-meditacion-amanecer.jpg';
import imgCosmos         from '../assets/blog/cosmos-estrellas.jpg';
import imgHumoOscuro     from '../assets/blog/srt-humo-oscuro.jpg';
import imgTerapia        from '../assets/blog/terapia-sesion.jpg';
import imgPortalLuz      from '../assets/blog/portal-luz.jpg';
import imgNinos          from '../assets/blog/ninos-naturaleza.jpg';
import imgMeditGrupal    from '../assets/blog/meditacion-grupal.jpg';
import imgRitualFuego    from '../assets/blog/ritual-fuego.jpg';
import imgSilueta        from '../assets/blog/silueta-espiritual.jpg';
import imgLibros         from '../assets/blog/libros-vintage.jpg';
import imgQueEs          from '../assets/blog/que-es-regresion.jpg';
import imgBeneficios     from '../assets/blog/beneficios-regresion.jpg';
import imgSesion         from '../assets/blog/sesion-regresion.jpg';

import type { ImageMetadata } from 'astro';

const IMG_REGISTRY: Record<string, ImageMetadata> = {
  'srt-velas-seance':    imgVelasSeance,
  'srt-vela-oscuridad':  imgVelaOscuridad,
  'srt-manos-luz':       imgManosLuz,
  'hipnosis-ojo-mistico': imgOjoMistico,
  'rvp-meditacion':      imgMeditacion,
  'hero-meditacion-amanecer': imgDefault,
  'cosmos-estrellas':    imgCosmos,
  'srt-humo-oscuro':     imgHumoOscuro,
  'terapia-sesion':      imgTerapia,
  'portal-luz':          imgPortalLuz,
  'ninos-naturaleza':    imgNinos,
  'meditacion-grupal':   imgMeditGrupal,
  'ritual-fuego':        imgRitualFuego,
  'silueta-espiritual':  imgSilueta,
  'libros-vintage':      imgLibros,
  'que-es-regresion':    imgQueEs,
  'beneficios-regresion': imgBeneficios,
  'sesion-regresion':    imgSesion,
};

const EXPOSITOR_IMG: Record<string, ImageMetadata> = {
  'carl-wickland':   imgVelasSeance,
  'william-baldwin': imgManosLuz,
  'edith-fiore':     imgMeditacion,
  'alan-sanderson':  imgMeditacion,
  'srt':             imgVelaOscuridad,
  'hipnosis':        imgOjoMistico,
};

interface Props extends CollectionEntry<'blog'>['data'] {
  readingTime?: number;
  postId?: string;
  relatedPosts?: CollectionEntry<'blog'>[];
  kind?: 'article' | 'about';
}

const { title, seoTitle, description, pubDate, updatedDate, heroImage, expositor, readingTime, postId, relatedPosts, kind = 'article' } = Astro.props;

function imageFor(id?: string, exp?: string, hero?: ImageMetadata): ImageMetadata {
  if (hero) return hero;
  if (id && SLUG_IMG[id]) {
    const key = SLUG_IMG[id];
    if (IMG_REGISTRY[key]) return IMG_REGISTRY[key];
  }
  if (exp && EXPOSITOR_IMG[exp]) return EXPOSITOR_IMG[exp];
  return imgDefault;
}

const displayImage = imageFor(postId, expositor, heroImage);
const cat = expositor ? CATEGORY[expositor] : undefined;

const JP = 'https://www.juanpabloloaiza.com';
const AUTHOR_LINKS = {
  srt: { href: `${JP}/#liberacion`, anchor: 'Sesiones de liberación espiritual' },
  hipnosis: { href: `${JP}/#ComoFunciona`, anchor: 'Hipnosis terapéutica en sesión' },
  rvp: { href: `${JP}/#QueEsTRVP`, anchor: 'Sesiones de regresión a vidas pasadas' },
};
const authorLink = AUTHOR_LINKS[cat?.group ?? 'rvp'];

const WHATSAPP = 'https://api.whatsapp.com/send?phone=56962081884&text=' +
  encodeURIComponent('Hola Juan Pablo, leí tu artículo en regresionvidaspasadas.com y quiero más información.');
const AUTHOR_PHOTO = 'https://media.juanpabloloaiza.com/images/jpl-newwsp.jpeg';

const PILLAR_SLUGS = [
  'que-es-la-regresion-a-vidas-pasadas',
  'como-funciona-una-sesion-de-regresion',
  'srt-que-es',
  'hipnosis-que-es-realmente',
].filter((s) => s !== postId).slice(0, 3);
const allPosts = await getCollection('blog');
const readMore = PILLAR_SLUGS
  .map((s) => allPosts.find((p) => p.id === s))
  .filter((p): p is CollectionEntry<'blog'> => Boolean(p))
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    label: p.data.expositor && CATEGORY[p.data.expositor] ? CATEGORY[p.data.expositor].label : 'Guía',
    image: imageFor(p.id, p.data.expositor, p.data.heroImage),
  }));

const siteUrl = Astro.site ?? 'https://www.regresionvidaspasadas.com';
const siteOrigin = new URL(siteUrl).origin;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const ogImage = new URL(displayImage.src, siteUrl);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonicalUrl.href}#article`,
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  image: ogImage.href,
  url: canonicalUrl.href,
  inLanguage: 'es',
  ...(readingTime ? { wordCount: readingTime * 200 } : {}),
  author: {
    '@type': 'Person',
    '@id': 'https://www.juanpabloloaiza.com/#person',
    name: 'Juan Pablo Loaiza',
    url: 'https://www.juanpabloloaiza.com',
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteOrigin}/#organization`,
    name: 'Regresión a Vidas Pasadas',
    url: siteUrl.toString(),
  },
  isPartOf: { '@id': `${siteOrigin}/#organization` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl.toString() },
    { '@type': 'ListItem', position: 2, name: 'Artículos', item: `${siteOrigin}/blog/` },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl.href },
  ],
};

const medicalWebPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalWebPage',
  '@id': `${canonicalUrl.href}#medicalpage`,
  name: title,
  url: canonicalUrl.href,
  description,
  inLanguage: 'es',
  medicalAudience: [
    { '@type': 'MedicalAudience', audienceType: 'Patient' },
    { '@type': 'MedicalAudience', audienceType: 'Caregiver' },
  ],
  about: {
    '@type': 'MedicalTherapy',
    name: 'Regresión a Vidas Pasadas',
    alternateName: ['RVP', 'Past Life Regression', 'Terapia de Regresión'],
  },
  author: { '@id': 'https://www.juanpabloloaiza.com/#person' },
  publisher: { '@id': `${siteOrigin}/#organization` },
};

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonicalUrl.href}#aboutpage`,
  name: title,
  url: canonicalUrl.href,
  description,
  inLanguage: 'es',
  isPartOf: { '@id': `${siteOrigin}/#website` },
  about: { '@id': `${siteOrigin}/#organization` },
};

const jsonLd = JSON.stringify(
  kind === 'about' ? [aboutSchema, breadcrumbSchema] : [articleSchema, breadcrumbSchema, medicalWebPageSchema],
);
---

<html lang="es">
  <head>
    <BaseHead title={title} seoTitle={seoTitle} description={description} image={displayImage} ogType={kind === 'about' ? 'website' : 'article'} />
    <script type="application/ld+json" set:html={jsonLd}></script>
    <style>
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
        font-family: 'Material Symbols Outlined';
        line-height: 1;
        display: inline-block;
        vertical-align: middle;
      }

      /* ——— Centered article header ——— */
      .article-header {
        padding: 4em 2em 3em;
        text-align: center;
        max-width: 860px;
        margin: 0 auto;
      }

      .article-header-badge {
        display: inline-block;
        padding: 0.35em 1.2em;
        border: 1px solid rgba(230,200,117,0.3);
        border-radius: 999px;
        font-family: 'Plus Jakarta Sans', serif;
        font-size: 0.5em;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #E6C875;
        background: rgba(230,200,117,0.05);
        margin-bottom: 1.5em;
      }

      .article-header h1 {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(1.8em, 5vw, 3.2em);
        font-weight: 900;
        color: #FAF7F2;
        line-height: 1.1;
        margin: 0 0 0.75em;
        letter-spacing: -0.01em;
      }

      .article-header-desc {
        font-family: 'EB Garamond', serif;
        font-size: 1.1em;
        font-style: italic;
        color: #C6C0B1;
        line-height: 1.65;
        max-width: 560px;
        margin: 0 auto 1.5em;
      }

      .article-header-meta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75em;
        flex-wrap: wrap;
      }

      .article-meta-by {
        font-family: 'Plus Jakarta Sans', serif;
        font-size: 0.55em;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #FAF7F2;
      }

      .article-meta-author {
        font-family: 'Plus Jakarta Sans', serif;
        font-size: 0.55em;
        letter-spacing: 0.12em;
        font-weight: 700;
        color: #FAF7F2;
        border-bottom: 1px solid #BA9C4B;
        padding-bottom: 0.05em;
      }

      .article-meta-dot { color: #E6C875; font-size: 0.8em; }

      .article-meta-date {
        font-family: 'Plus Jakarta Sans', serif;
        font-size: 0.55em;
        letter-spacing: 0.1em;
        color: #C6C0B1;
        text-transform: uppercase;
      }

      /* ——— Hero image (full width) ——— */
      .article-hero-img-wrap {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto 4em;
        height: 480px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 40px rgba(0,0,0,0.15);
      }

      .article-hero-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s ease;
        max-width: none;
        border-radius: 0;
      }
      .article-hero-img-wrap:hover .article-hero-img { transform: scale(1.03); }

      .article-hero-gradient {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.3) 0%, transparent 50%);
      }

      /* ——— 12-col article grid ——— */
      .article-grid {
        display: grid;
        grid-template-columns: 260px 1fr;
        gap: 4em;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2em 5em;
        align-items: start;
      }

      /* ——— Sticky left sidebar ——— */
      .article-sidebar {
        position: sticky;
        top: 5em;
        display: flex;
        flex-direction: column;
        gap: 2.5em;
      }

      /* TOC */
      .sidebar-toc {
        border-left: 1px solid rgba(230,200,117,0.25);
        padding-left: 1.5em;
      }

      .sidebar-toc-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.52em;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: #E6C875;
        margin: 0 0 1.25em;
        font-weight: 700;
      }

      .sidebar-toc-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.75em;
      }

      .sidebar-toc-link {
        font-family: 'EB Garamond', serif;
        font-size: 1em;
        color: #FAF7F2;
        text-decoration: none;
        line-height: 1.3;
        transition: color 0.2s;
        display: block;
      }
      .sidebar-toc-link:hover { color: #E6C875; text-decoration: none; }
      .sidebar-toc-link.active { color: #E6C875; }

      /* Related articles sidebar block */
      .sidebar-related {
        background: #151E1D;
        padding: 1.75em;
      }

      .sidebar-related-title {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.5em;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: #E6C875;
        margin: 0 0 1.5em;
        font-weight: 700;
      }

      .sidebar-related-list {
        display: flex;
        flex-direction: column;
        gap: 1.5em;
      }

      .sidebar-related-item { text-decoration: none; color: inherit; display: block; }

      .sidebar-related-cat {
        font-family: 'Plus Jakarta Sans', serif;
        font-size: 0.45em;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #E6C875;
        display: block;
        margin-bottom: 0.3em;
      }

      .sidebar-related-item-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 0.9em;
        font-weight: 700;
        color: #FAF7F2;
        line-height: 1.25;
        transition: color 0.2s;
      }
      .sidebar-related-item:hover .sidebar-related-item-title { color: #E6C875; }

      /* Newsletter mini */
      .sidebar-newsletter-mini {
        border: 1px solid rgba(230,200,117,0.2);
        padding: 1.75em;
        text-align: center;
      }

      .sidebar-newsletter-mini .mat-icon { font-size: 1.8em; color: #E6C875; display: block; margin-bottom: 0.75em; }

      .sidebar-newsletter-mini-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1em;
        font-weight: 700;
        margin: 0 0 0.75em;
      }

      .sidebar-newsletter-mini-desc {
        font-family: 'EB Garamond', serif;
        font-size: 0.82em;
        font-style: italic;
        color: #C6C0B1;
        line-height: 1.55;
        margin-bottom: 1.25em;
      }

      .sidebar-newsletter-mini input {
        width: 100%;
        box-sizing: border-box;
        background: #FAF7F2;
        color: #0E1514;
        border: 1px solid #E6C875;
        border-radius: 12px;
        padding: 0.75em 1em;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.8em;
        margin-bottom: 0.6em;
        outline: none;
      }
      .sidebar-newsletter-mini input::placeholder { color: #6B6558; opacity: 1; }
      .sidebar-newsletter-mini input:focus { border-color: #F5DC98; box-shadow: 0 0 0 3px rgba(230,200,117,0.3); }

      .sidebar-newsletter-mini button {
        width: 100%;
        padding: 0.85em;
        background: linear-gradient(135deg, #F5DC98 0%, #E6C875 50%, #C99F44 100%);
        color: #0E1514;
        border: none;
        border-radius: 999px;
        cursor: pointer;
        font-family: 'Syne', sans-serif;
        font-size: 0.5em;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        transition: filter 0.2s;
      }
      .sidebar-newsletter-mini button:hover { filter: brightness(1.08); }
      .sidebar-newsletter-mini button:disabled { opacity: 0.7; cursor: default; }
      .sidebar-newsletter-mini-consent { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.55em; line-height: 1.5; color: rgba(250,247,242,0.55); margin: 0.4em 0 0; }
      .sidebar-newsletter-mini-msg { font-family: 'EB Garamond', serif; font-size: 0.8em; min-height: 1.2em; margin: 0.6em 0 0; line-height: 1.3; }

      /* ——— Article body ——— */
      .article-body { min-width: 0; }

      .prose {
        font-family: 'EB Garamond', serif;
        font-size: 1.15em;
        line-height: 1.8;
        color: #FAF7F2;
        max-width: 680px;
      }

      /* Drop cap on first paragraph */
      .prose :global(p:first-of-type)::first-letter {
        float: left;
        font-family: 'Cormorant Garamond', serif;
        font-size: 4.5em;
        line-height: 0.8;
        padding: 0.1em 0.4em 0 0;
        color: #E6C875;
        font-weight: 900;
      }

      .prose :global(h2) {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.5em;
        font-weight: 700;
        color: #FAF7F2;
        margin: 2.5em 0 0.75em;
        line-height: 1.2;
      }

      .prose :global(h3) {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.2em;
        font-weight: 700;
        color: #D9D3C5;
        margin: 2em 0 0.6em;
      }

      .prose :global(p) {
        margin-bottom: 1.4em;
        line-height: 1.8;
      }

      .prose :global(strong) {
        color: #FAF7F2;
        font-weight: 600;
      }

      .prose :global(blockquote) {
        border-left: 4px solid #BA9C4B;
        margin: 2em 0;
        padding: 1.25em 2em;
        background: rgba(21,30,29,0.4);
        font-style: italic;
        color: #FAF7F2;
      }

      .prose :global(blockquote p) {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.2em;
        line-height: 1.55;
        margin: 0;
      }

      .prose :global(ul), .prose :global(ol) {
        padding-left: 1.5em;
        margin-bottom: 1.4em;
      }

      .prose :global(li) {
        margin-bottom: 0.5em;
        line-height: 1.7;
      }

      .prose :global(img) {
        width: 100%;
        height: auto;
        margin: 2em 0;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
      }

      /* ——— Ornamental divider ——— */
      .ornament {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1em;
        margin: 3em 0;
      }
      .ornament::before, .ornament::after {
        content: "";
        height: 1px;
        flex-grow: 1;
        background: linear-gradient(to right, transparent, #E6C875, transparent);
      }
      .ornament span { color: #E6C875; font-size: 1em; }

      /* ——— Share actions ——— */
      .share-bar {
        display: flex;
        align-items: center;
        gap: 1.5em;
        padding-top: 2.5em;
        border-top: 1px solid rgba(230,200,117,0.12);
        margin-top: 2.5em;
      }

      .share-bar-label {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.52em;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #C6C0B1;
      }

      .share-btns { display: flex; gap: 0.75em; }

      .share-btn {
        width: 40px;
        height: 40px;
        border-radius: 999px;
        border: 1px solid rgba(230,200,117,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        background: none;
        cursor: pointer;
        color: #C6C0B1;
        font-size: 1.1em;
        transition: background 0.2s, color 0.2s;
        text-decoration: none;
      }
      .share-btn:hover {
        background: #E6C875;
        color: #0E1514;
        border-color: #BA9C4B;
        text-decoration: none;
      }

      /* ——— Author CTA ——— */
      .author-cta {
        margin-top: 3em;
        padding: 1.5em 1.75em;
        background: #151E1D;
        border-left: 3px solid rgba(230,200,117,0.35);
      }

      .author-cta-label {
        display: block;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.52em;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #BA9C4B;
        margin-bottom: 0.6em;
        font-weight: 700;
      }

      .author-cta p {
        font-family: 'EB Garamond', serif;
        font-size: 0.9em;
        color: #C6C0B1;
        line-height: 1.65;
        margin: 0;
      }

      .author-cta a { color: #E6C875; text-decoration: none; }
      .author-cta a:hover { text-decoration: underline; }

      /* ——— Sobre el autor (ficha, diseño Stitch adaptado) ——— */
      .author-card {
        margin-top: 3em;
        padding: 2em 2.25em;
        background: #151E1D;
        border: 1px solid rgba(230,200,117,0.25);
        border-radius: 12px;
        box-shadow: 0 10px 35px -10px rgba(0,0,0,0.08), 0 2px 8px rgba(230,200,117,0.05);
      }
      .author-card-main { display: flex; gap: 2em; align-items: flex-start; }
      .author-card-photo-ring {
        flex-shrink: 0; width: 124px; height: 124px; padding: 3px; border-radius: 50%;
        background: linear-gradient(135deg, #E6C875 0%, #F5DC98 50%, rgba(230,200,117,0.4) 100%);
        box-shadow: 0 4px 16px rgba(230,200,117,0.22);
      }
      .author-card-photo {
        width: 100%; height: 100%; border-radius: 50%;
        object-fit: cover; object-position: 50% 22%; display: block;
      }
      .author-card-label {
        display: flex; align-items: center; gap: 0.6em;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.55em; letter-spacing: 0.22em; text-transform: uppercase;
        color: #E6C875; font-weight: 700; margin-bottom: 0.5em;
      }
      .author-card-rule { display: inline-block; width: 1.4em; height: 1px; background: #E6C875; }
      .author-card-name {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.7em; line-height: 1.2; margin: 0; color: #FAF7F2; letter-spacing: -0.01em;
      }
      .author-card-name a { color: inherit; text-decoration: none; }
      .author-card-name a:hover { color: #E6C875; }
      .author-card-role {
        font-family: 'EB Garamond', serif; font-style: italic;
        font-size: 1.05em; color: #C6C0B1; margin: 0.15em 0 0.7em;
      }
      .author-card-bio {
        font-family: 'EB Garamond', serif;
        font-size: 1.05em; line-height: 1.6; color: rgba(250,247,242,0.9); margin: 0;
      }
      .author-card-trust {
        list-style: none; margin: 1.5em 0 0; padding: 1.1em 0 0;
        border-top: 1px solid rgba(230,200,117,0.22);
        display: grid; grid-template-columns: repeat(3, auto); gap: 0.8em 1.5em; justify-content: start;
      }
      .author-card-trust li {
        display: flex; align-items: center; gap: 0.55em;
        font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.6em; font-weight: 500;
        letter-spacing: 0.06em; text-transform: uppercase; color: rgba(250,247,242,0.8);
      }
      .author-card-trust svg { width: 1.6em; height: 1.6em; color: #E6C875; flex-shrink: 0; }
      .author-card-actions { display: flex; flex-wrap: wrap; gap: 0.7em; margin-top: 1.4em; }
      .author-card-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.6em;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 0.62em; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
        padding: 1em 1.5em; border: 1px solid rgba(230,200,117,0.6); border-radius: 999px;
        color: #FAF7F2; text-decoration: none; background: transparent;
        transition: background .2s, border-color .2s, color .2s;
      }
      .author-card-btn:hover { background: rgba(230,200,117,0.1); border-color: #BA9C4B; text-decoration: none; }
      .author-card-btn svg { width: 1.5em; height: 1.5em; color: #F5DC98; }
      .author-card-btn--primary { background: #090E0D; border-color: rgba(250,247,242,0.25); color: #FAF7F2; }
      .author-card-btn--primary:hover { background: #151E1D; border-color: #3D2C15; }

      /* ——— Sigue leyendo (tarjetas con imagen) ——— */
      .read-more { margin-top: 2.5em; }
      .read-more-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.25em; color: #FAF7F2; margin: 0 0 1em;
        padding-bottom: 0.4em; border-bottom: 1px solid rgba(230,200,117,0.35);
      }
      .read-more-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25em; }
      .read-more-card {
        display: flex; flex-direction: column; text-decoration: none; color: inherit;
        background: #0E1514; border: 1px solid rgba(230,200,117,0.2); border-radius: 12px;
        overflow: hidden; transition: transform .2s, box-shadow .2s;
      }
      .read-more-card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(0,0,0,0.14); }
      .read-more-img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
      .read-more-cat {
        font-family: 'Plus Jakarta Sans', sans-serif; font-size: 0.5em; letter-spacing: 0.16em;
        text-transform: uppercase; font-weight: 700; color: #E6C875; padding: 0.9em 1.2em 0;
      }
      .read-more-card-title {
        font-family: 'Cormorant Garamond', serif; font-size: 0.95em; line-height: 1.3;
        color: #FAF7F2; padding: 0.4em 1.2em 1.3em;
      }
      .read-more-card:hover .read-more-card-title { color: #E6C875; }

      /* ——— Responsive ——— */
      @media (max-width: 900px) {
        .article-grid {
          grid-template-columns: 1fr;
          padding: 0 1.25em 4em;
          gap: 2.5em;
        }
        .article-sidebar {
          position: static;
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 1.5em;
        }
        .sidebar-toc { display: none; }
        .article-hero-img-wrap { height: 340px; }
      }

      @media (max-width: 760px) {
        .read-more-grid { grid-template-columns: 1fr; }
        .author-card { padding: 1.5em 1.25em; }
        .author-card-main { flex-direction: column; align-items: center; text-align: center; }
        .author-card-label { justify-content: center; }
        .author-card-trust { grid-template-columns: 1fr; justify-items: center; }
        .author-card-actions { flex-direction: column; }
      }

      @media (max-width: 600px) {
        .article-header { padding: 2.5em 1.25em 2em; }
        .article-sidebar { grid-template-columns: 1fr; }
        .article-hero-img-wrap { height: 260px; }
        .prose { font-size: 1em; }
        .prose :global(p:first-of-type)::first-letter { font-size: 3.5em; }
      }
    </style>
  </head>

  <body>
    <Header />

    <!-- Centered article header -->
    <div class="article-header">
      {cat ? (
        <span class="article-header-badge">{cat.label}</span>
      ) : (
        <span class="article-header-badge">Investigación</span>
      )}
      <h1>{title}</h1>
      {description && <p class="article-header-desc">{description}</p>}
      <div class="article-header-meta">
        <span class="article-meta-by">Por</span>
        <a class="article-meta-author" href="https://www.juanpabloloaiza.com" rel="author" style="text-decoration:none">Juan Pablo Loaiza</a>
        <span class="article-meta-dot">•</span>
        <span class="article-meta-date"><FormattedDate date={pubDate} /></span>
        {readingTime && (
          <>
            <span class="article-meta-dot">•</span>
            <span class="article-meta-date">{readingTime} min</span>
          </>
        )}
      </div>
    </div>

    <!-- Full-width hero image -->
    <div class="article-hero-img-wrap">
      <Image
        width={1100}
        height={480}
        src={displayImage}
        alt={title}
        class="article-hero-img"
      />
      <div class="article-hero-gradient"></div>
    </div>

    <!-- 12-col grid: sidebar left + article body -->
    <div class="article-grid">

      <!-- LEFT SIDEBAR (sticky) -->
      <aside class="article-sidebar">

        <!-- TOC — populated by JS -->
        <div class="sidebar-toc" id="article-toc">
          <h4 class="sidebar-toc-title">Contenido</h4>
          <ul class="sidebar-toc-list" id="toc-list">
            <!-- filled by client JS -->
          </ul>
        </div>

        <!-- Related articles -->
        {relatedPosts && relatedPosts.length > 0 && (
          <div class="sidebar-related">
            <h4 class="sidebar-related-title">Relacionados</h4>
            <div class="sidebar-related-list">
              {relatedPosts.map(p => {
                const relCat = p.data.expositor ? CATEGORY[p.data.expositor] : undefined;
                return (
                  <a href={`/blog/${p.id}/`} class="sidebar-related-item">
                    <span class="sidebar-related-cat">{relCat ? relCat.label : 'Investigación'}</span>
                    <span class="sidebar-related-item-title">{p.data.title}</span>
                  </a>
                );
              })}
            </div>
          </div>
        )}

        <!-- Newsletter mini -->
        <div class="sidebar-newsletter-mini">
          <span class="material-symbols-outlined mat-icon">mail</span>
          <h4 class="sidebar-newsletter-mini-title">Crónica Editorial</h4>
          <p class="sidebar-newsletter-mini-desc">Reflexiones mensuales sobre la evolución del espíritu.</p>
          <form id="newsletter-form-article">
            <input type="email" placeholder="Tu correo" aria-label="Tu correo electrónico" autocomplete="email" required />
            <button type="submit">Suscribirse</button>
            <p class="sidebar-newsletter-mini-msg" id="newsletter-msg-article" aria-live="polite"></p>
            <p class="sidebar-newsletter-mini-consent">Te enviaremos un correo para confirmar. Puedes darte de baja cuando quieras.</p>
          </form>
        </div>

      </aside>

      <!-- ARTICLE BODY -->
      <article class="article-body">
        <div class="prose" id="prose-content">
          <slot />
        </div>

        {kind === 'article' && <ShareButtons path={Astro.url.pathname} title={title} label="Compartir este artículo" />}

        <!-- Ornament divider before CTA -->
        <div class="ornament">
          <span class="material-symbols-outlined" style="font-size:1em">auto_awesome</span>
        </div>

        <!-- Sobre el autor -->
        <aside class="author-card" aria-label="Sobre el autor">
          <div class="author-card-main">
            <div class="author-card-photo-ring">
              <img
                class="author-card-photo"
                src={AUTHOR_PHOTO}
                alt="Juan Pablo Loaiza, terapeuta de Regresión a Vidas Pasadas"
                width="124"
                height="124"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="author-card-body">
              <span class="author-card-label"><i class="author-card-rule"></i>Sobre el autor</span>
              <h3 class="author-card-name"><a href="https://www.juanpabloloaiza.com" rel="author">Juan Pablo Loaiza</a></h3>
              <p class="author-card-role">Terapeuta de Regresión a Vidas Pasadas</p>
              <p class="author-card-bio">
                Acompaña procesos de regresión a vidas pasadas.
                Atiende sesiones online a personas de todo el mundo.
              </p>
            </div>
          </div>
          <ul class="author-card-trust">
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"/></svg>
              +19 años de experiencia
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path stroke-linecap="round" stroke-linejoin="round" d="M8 21h8m-4-4v4"/></svg>
              Sesiones online
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8M12 3a14.5 14.5 0 000 18 14.5 14.5 0 000-18z"/></svg>
              Atención en todo el mundo
            </li>
          </ul>
          <div class="author-card-actions">
            <a class="author-card-btn author-card-btn--primary" href={WHATSAPP} target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0012.04 2zm0 18.09c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.1 8.1 0 01-1.24-4.32c0-4.48 3.65-8.13 8.13-8.13 2.17 0 4.21.85 5.75 2.38a8.07 8.07 0 012.38 5.74c0 4.49-3.65 8.14-8.13 8.14zm4.46-6.1c-.24-.12-1.45-.72-1.68-.8-.22-.08-.39-.12-.55.12-.17.24-.63.8-.78.96-.14.16-.29.18-.54.06-.24-.12-1.03-.38-1.97-1.21-.73-.65-1.22-1.45-1.36-1.7-.14-.24-.02-.37.11-.49.11-.11.24-.29.36-.43.12-.14.16-.24.24-.4.08-.16.04-.31-.02-.43-.06-.12-.55-1.33-.76-1.82-.2-.48-.41-.41-.56-.42h-.48c-.16 0-.43.06-.66.31-.22.24-.87.85-.87 2.08 0 1.22.89 2.41 1.01 2.58.12.16 1.76 2.69 4.27 3.77.6.26 1.06.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.45-.6 1.66-1.17.2-.57.2-1.06.14-1.17-.06-.11-.22-.18-.46-.3z"/></svg>
              Escríbele por WhatsApp
            </a>
            <a class="author-card-btn" href={authorLink.href}>{authorLink.anchor} →</a>
          </div>
        </aside>

        <!-- Sigue leyendo -->
        {readMore.length > 0 && (
          <section class="read-more" aria-label="Sigue leyendo">
            <h3 class="read-more-title">Sigue leyendo</h3>
            <div class="read-more-grid">
              {readMore.map((r) => (
                <a class="read-more-card" href={`/blog/${r.id}/`}>
                  <Image class="read-more-img" src={r.image} alt="" width={420} height={260} loading="lazy" />
                  <span class="read-more-cat">{r.label}</span>
                  <span class="read-more-card-title">{r.title}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Share bar -->
        <div class="share-bar">
          <span class="share-bar-label">Compartir:</span>
          <div class="share-btns">
            <a class="share-btn" href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(canonicalUrl.href)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener" aria-label="Compartir en Twitter">
              <span class="material-symbols-outlined" style="font-size:1em">share</span>
            </a>
            <button class="share-btn" onclick="navigator.clipboard?.writeText(window.location.href)" aria-label="Copiar enlace">
              <span class="material-symbols-outlined" style="font-size:1em">link</span>
            </button>
            <button class="share-btn" onclick="window.print()" aria-label="Imprimir">
              <span class="material-symbols-outlined" style="font-size:1em">print</span>
            </button>
          </div>
        </div>
      </article>
    </div>

    <Footer />

    <script>
      // Build TOC from article headings
      const tocList = document.getElementById('toc-list');
      const prose = document.getElementById('prose-content');
      if (tocList && prose) {
        const headings = Array.from(prose.querySelectorAll('h2, h3'));
        if (headings.length < 2) {
          const tocEl = document.getElementById('article-toc');
          if (tocEl) tocEl.style.display = 'none';
        } else {
          headings.forEach((h, i) => {
            if (!h.id) h.id = `section-${i}`;
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = `#${h.id}`;
            a.textContent = h.textContent ?? '';
            a.className = 'sidebar-toc-link';
            if (h.tagName === 'H3') a.style.paddingLeft = '1em';
            a.addEventListener('click', e => {
              e.preventDefault();
              document.getElementById(h.id)?.scrollIntoView({ behavior: 'smooth' });
            });
            li.appendChild(a);
            tocList.appendChild(li);
          });

          // Active section highlighting
          const observer = new IntersectionObserver(entries => {
            entries.forEach(entry => {
              const link = tocList.querySelector(`[href="#${entry.target.id}"]`);
              if (link) link.classList.toggle('active', entry.isIntersecting);
            });
          }, { rootMargin: '-20% 0% -70% 0%' });

          headings.forEach(h => observer.observe(h));
        }
      }
    </script>
    <script>
      import { setupNewsletter } from '../scripts/newsletter';
      setupNewsletter('newsletter-form-article', 'newsletter-msg-article', 'Suscribirse', 'articulo');
    </script>
  </body>
</html>
